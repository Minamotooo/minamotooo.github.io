{% comment %}
  Author line for a publication entry. names: array of names (see people_list.liquid).
  The "* Equal contribution" key sits next to the section heading (.pub-legend).
{% endcomment %}
{%- if include.names.size > 0 -%}
  <div class="author">{% include people_list.liquid names=include.names %}</div>
{%- endif -%}
