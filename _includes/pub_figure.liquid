{% comment %}
  A paper's key figure, shown under its title. `file` is a name in assets/img/publication_preview/.
  Height is capped so tall figures don't dominate the list; clicking opens it full size (medium-zoom).
{% endcomment %}
{% assign fig_alt = include.alt | default: include.title %}
<figure class="pub-figure">
  <img
    src="{{ include.file | prepend: '/assets/img/publication_preview/' | relative_url }}"
    alt="{{ fig_alt | strip_html | escape }}"
    loading="lazy"
    decoding="async"
    data-zoomable
  >
</figure>
