{% comment %}
  Upcoming papers from _data/coming_soon.yml (title + abstract only).
  Used by the "Upcoming" tab on the About and Publications pages.
{% endcomment %}
<ol class="bibliography">
  {% for paper in site.data.coming_soon %}
    <li>
      <div class="row">
        <div class="col col-sm-2 abbr">
          <abbr class="badge rounded">Soon</abbr>
        </div>
        <div class="col-sm-10{% if paper.figure %} has-figure{% endif %}">
          {% if paper.figure %}
            {% include pub_figure.liquid file=paper.figure alt=paper.figure_alt title=paper.title %}
          {% endif %}
          <div class="title">{{ paper.title }}</div>
          <div class="links">
            <a class="abstract btn btn-sm z-depth-0" role="button">Abstract</a>
          </div>
          <div class="abstract hidden">
            <p>{{ paper.abstract }}</p>
          </div>
        </div>
      </div>
    </li>
  {% endfor %}
</ol>
