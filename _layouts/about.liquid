---
layout: default
---

{% if site.title == 'blank' %}
  {% assign full_name = site.first_name | append: ' ' | append: site.middle_name | append: ' ' | append: site.last_name | strip %}
{% else %}
  {% assign full_name = site.title %}
{% endif %}

<div class="post about">
  <section class="hero">
    <div class="hero__text">
      <header class="hero__head">
        <h1 class="hero__name">{{ full_name }}</h1>
        {% if page.subtitle %}
          <p class="hero__subtitle">{{ page.subtitle }}</p>
        {% endif %}
      </header>
      <div class="hero__bio">{{ content }}</div>
      <div class="hero__actions">
        <a class="btn-primary" href="{{ '/cv/' | relative_url }}">View resume <i class="fa-solid fa-arrow-right"></i></a>
        {% if page.social %}
          <div class="social social--compact">
            <div class="contact-icons">{% social_links %}</div>
          </div>
        {% endif %}
      </div>
    </div>

    {% if page.profile and page.profile.image %}
      {% comment %}
        The original file is used (not the theme's downscaled webp copies) so the portrait stays sharp
        when it is cropped to fill the column on high-DPI screens.
      {% endcomment %}
      <div class="hero__photo{% if page.profile.image_circular %} hero__photo--circle{% endif %}">
        <img class="hero__img" src="{{ page.profile.image | prepend: '/assets/img/' | relative_url | bust_file_cache }}" alt="{{ full_name }}" loading="eager">
      </div>
    {% endif %}
  </section>

  <article id="home-content">
    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <section class="home-section">
        <div class="section-head">
          <h2>News</h2>
          <a class="section-more" href="{{ '/news/' | relative_url }}">All news →</a>
        </div>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <section class="home-section">
        <div class="section-head">
          <h2>Latest Posts</h2>
          <a class="section-more" href="{{ '/blog/' | relative_url }}">All posts →</a>
        </div>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <section class="home-section">
        <div class="section-head">
          <h2>Selected Publications</h2>
          <a class="section-more" href="{{ '/publications/' | relative_url }}">All publications →</a>
        </div>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    <!-- Work Experience -->
    {% if site.data.work_experience %}
      <section class="home-section">
        <div class="section-head">
          <h2>Work Experience</h2>
          <a class="section-more" href="{{ '/cv/' | relative_url }}">Full resume →</a>
        </div>
        <div class="card-stack">
          {% for job in site.data.work_experience %}
            <article class="af-card xp-card">
              <div class="xp-card__top">
                <h3 class="xp-card__role">{{ job.role }}</h3>
                <span class="xp-card__period">{{ job.period }}</span>
              </div>
              <p class="xp-card__org">{{ job.subtitle }}</p>
              {% if job.tags %}
                <p class="xp-card__meta">{{ job.tags | join: ' · ' }}</p>
              {% endif %}
              <div class="xp-card__desc">{{ job.description }}</div>
              {% if job.supervisors %}
                <p class="xp-card__sup">
                  Supervised by
                  {% for sup in job.supervisors %}
                    <a href="{{ sup.url }}" target="_blank" rel="noopener">{{ sup.name }}</a>{% unless forloop.last %} and {% endunless %}
                  {% endfor %}
                </p>
              {% endif %}
              {% if job.links %}
                <div class="pill-row xp-card__links">
                  {% for link in job.links %}
                    <a class="pill-link" href="{{ link.url }}" target="_blank" rel="noopener"><i class="{{ link.icon }}"></i>{{ link.label }}</a>
                  {% endfor %}
                </div>
              {% endif %}
            </article>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    <!-- Selected projects -->
    {% assign selected_projects = site.projects | where: "selected", true | sort: "importance" %}
    {% if selected_projects.size > 0 %}
      <section class="home-section">
        <div class="section-head">
          <h2>Selected Projects</h2>
          <a class="section-more" href="{{ '/projects/' | relative_url }}">All projects →</a>
        </div>
        <div class="card-stack">
          {% for project in selected_projects %}
            {% include project_card.liquid project=project %}
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center_margin.liquid %}
      {% else %}
        {% include newsletter.liquid center=true %}
      {% endif %}
    {% endif %}
  </article>
</div>
